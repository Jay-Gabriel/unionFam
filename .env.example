# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_publishable_or_anon_key

# Server-only secrets — never expose through NEXT_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
GEMINI_API_KEY=replace_with_server_only_gemini_api_key

# Runtime configuration
AI_MODEL=replace_with_selected_model_id
PROMPT_CONFIG_KEY_OR_REF=dev-placeholder
APP_BASE_URL=http://localhost:3000

# Google OAuth Client ID/Secret are normally configured in Supabase Auth provider settings,
# not sent to the browser and not committed here.


# Life Lab V8.7.2 — biến môi trường mẫu (KHÔNG chứa bí mật thật)

# ---- Server ----
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Ví dụ dev dùng docker: postgres://postgres:postgres@localhost:5433/lifelab
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifelab

# ---- AI provider (server-side only; KHÔNG để key ở frontend) ----
# mock = không cần key (dev/test). gemini = cần AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=12000

# ---- Safety resources theo thị trường (KHÔNG bịa số) ----
# JSON mảng; nếu để trống → dùng hướng dẫn chung, không tạo số điện thoại.
# Ví dụ (thay bằng số CHÍNH THỨC đã xác minh cho thị trường của bạn):
# SAFETY_RESOURCES_JSON=[{"label":"Đường dây nóng ABC","value":"<số chính thức>","kind":"HOTLINE"}]
SAFETY_RESOURCES_JSON=
SAFETY_MARKET=generic

# ---- Entitlement / billing (chưa bật thu tiền thật) ----
FREE_TURN_LIMIT=60
BILLING_ENABLED=false

vec2 rotate2D(vec2 value, float angle)
{
    float s = sin(angle);
    float c = cos(angle);
    mat2 m = mat2(c, s, -s, c);
    return m * value;
}
`,iQ=`
uniform float uTime;
uniform sampler2D uPerlinTexture;
uniform vec3 uColor;
uniform float uOpacity;
uniform vec2 uTile;      // quanto rumore sta nel piano (x = larghezza, y = altezza)
uniform float uRiseSpeed; // velocit\xe0 di salita delle volute
uniform float uThreshold; // soglia dello smoothstep: pi\xf9 alta = fumo pi\xf9 rado
uniform float uTopFade;   // lunghezza della dissolvenza in cima

varying vec2 vUv;

void main()
{
  // scala e animazione: la texture scorre verso l'alto
  vec2 smokeUv = vUv * uTile;
  smokeUv.y -= uTime * uRiseSpeed;

  float smoke = texture(uPerlinTexture, smokeUv).r;

  // rimappatura: sotto la soglia niente fumo
  smoke = smoothstep(uThreshold, 1.0, smoke);

  // bordi sfumati: laterali e base corti, la cima lunga (si dissolve salendo)
  smoke *= smoothstep(0.0, 0.1, vUv.x);
  smoke *= smoothstep(0.0, 0.1, 1.0 - vUv.x);
  smoke *= smoothstep(0.0, 0.1, vUv.y);
  smoke *= smoothstep(0.0, uTopFade, 1.0 - vUv.y);

  gl_FragColor = vec4(uColor, smoke * uOpacity);

  #include <tonemapping_fragment>
  #include <colorspace_fragment>
}
`,iZ=`
uniform float uTime;
uniform sampler2D uPerlinTexture;
uniform float uTwist;
uniform float uWind;
uniform float uWindSpeed;

varying vec2 vUv;

void main()
{
  vec3 newPosition = position;

  // torsione lenta attorno all'asse verticale
  float twistPerlin = texture(uPerlinTexture, vec2(0.5, uv.y * 0.2 - uTime * 0.005)).r;
  float angle = twistPerlin * uTwist;
  newPosition.xz = rotate2D(newPosition.xz, angle);

  // vento: sposta la colonna, quasi nulla in basso, molto in alto
  vec2 windOffset = vec2(
    texture(uPerlinTexture, vec2(0.25, uTime * uWindSpeed)).r - 0.5,
    texture(uPerlinTexture, vec2(0.75, uTime * uWindSpeed)).r - 0.5
  );
  windOffset *= pow(uv.y, 2.0) * uWind;
  newPosition.xz += windOffset;

  gl_Position = projectionMatrix * modelViewMatrix * vec4(newPosition, 1.0);

  vUv = uv;
}
